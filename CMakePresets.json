{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "debug",
      "displayName": "Debug with AddressSanitizer and UBSan",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CATAN_SANITIZE": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release (default compiler)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "clang-release",
      "displayName": "Release with clang++",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "profile",
      "displayName": "Release with debug info and frame pointers, for perf",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_FLAGS": "-g -fno-omit-frame-pointer",
        "CATAN_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "python",
      "displayName": "Release Python module for tools/difftest.py",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CATAN_BUILD_PYTHON": "ON",
        "CATAN_BUILD_TESTS": "OFF",
        "CATAN_BUILD_BENCHMARKS": "OFF",
        "Python_EXECUTABLE": "${sourceDir}/../catan-project/backend/.venv/bin/python"
      }
    },
    {
      "name": "wasm",
      "displayName": "WebAssembly module for the web viewer (needs emsdk_env.sh)",
      "inherits": "base",
      "toolchainFile": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_FLAGS": "-fwasm-exceptions",
        "CMAKE_EXE_LINKER_FLAGS": "-fwasm-exceptions",
        "CATAN_BUILD_TESTS": "OFF",
        "CATAN_BUILD_BENCHMARKS": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "clang-release",
      "configurePreset": "clang-release"
    },
    {
      "name": "profile",
      "configurePreset": "profile"
    },
    {
      "name": "python",
      "configurePreset": "python"
    },
    {
      "name": "wasm",
      "configurePreset": "wasm"
    }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": false
      }
    },
    {
      "name": "debug",
      "inherits": "base",
      "configurePreset": "debug",
      "environment": {
        "ASAN_OPTIONS": "abort_on_error=1:detect_leaks=1",
        "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "configurePreset": "release"
    },
    {
      "name": "clang-release",
      "inherits": "base",
      "configurePreset": "clang-release"
    }
  ]
}
